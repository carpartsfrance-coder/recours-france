{
  "name": "recours-france",
  "version": "1.0.0",
  "private": true,
  "description": "Recours France — plateforme privée indépendante de signalement des litiges de consommation",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "prisma generate && next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "sync": "tsx scripts/sync.ts",
    "scores": "tsx scripts/recalcul-indices.ts",
    "purge": "tsx scripts/purge.ts",
    "relances": "tsx scripts/relances.ts",
    "contestations": "tsx scripts/contestations.ts",
    "import:sites": "tsx scripts/import-sites.ts",
    "import:entreprises": "tsx scripts/import-entreprises.ts",
    "import:boutiques": "tsx scripts/import-boutiques.ts",
    "nettoyer:boutiques": "tsx scripts/nettoyer-boutiques.ts",
    "adresses:extraire": "tsx scripts/enrichir-adresses.ts",
    "adresses:charger": "bash scripts/charger-adresses.sh",
    "db:index-annuaire": "bash -c 'psql \"$(grep -m1 ^DATABASE_URL .env | cut -d= -f2- | tr -d \\\" | sed s/?.*//)\" -f scripts/index-annuaire.sql'",
    "compteurs": "tsx scripts/compteurs-annuaire.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.1",
    "nodemailer": "^7.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
