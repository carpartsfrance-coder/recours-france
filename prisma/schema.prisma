// Recours France — modèle de données
//
// Principes structurants, opposables car affichés à l'utilisateur :
//  1. Un signalement sans justificatif contrôlé est NON VÉRIFIÉ : il n'entre dans
//     aucune statistique de comportement, seulement dans le volume agrégé.
//  2. Une résolution n'est comptabilisée qu'après confirmation explicite du consommateur.
//  3. Le score d'expérience n'est publié qu'à partir de 30 signalements vérifiés / 12 mois.
//  4. L'indice de transparence ne dépend QUE des données publiques.
//  5. Chaque donnée affichée porte sa source et sa date de vérification (modèle DonneeSource).
//  6. Aucun texte libre du consommateur n'est publié tel quel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────────────────────

/// Provenance d'une donnée. Affichée systématiquement à côté de la donnée.
enum Source {
  SIRENE
  RNE
  BODACC
  MEDIATEURS
  SITE_OFFICIEL
  CONSOMMATEUR
  RECOURS_FRANCE
}

enum EtatAdministratif {
  ACTIVE
  CESSEE
}

enum CategorieLitige {
  REMBOURSEMENT
  LIVRAISON
  GARANTIE
  SAV
  RESILIATION
  AUTRE
}

enum ContactPrealable {
  ECRIT
  TELEPHONE
  AUCUN
}

/// Niveau de vérification d'un signalement. « verifie » suppose un justificatif
/// contrôlé manuellement par Recours France.
/// Niveau de preuve atteint par un signalement.
///
/// Il décrit ce que Recours France a RÉELLEMENT fait, pas ce qu'on aimerait
/// promettre. Aucun contrôle humain systématique n'est effectué : un
/// justificatif est enregistré et scellé au dépôt, et n'est examiné que si
/// l'entreprise conteste le signalement.
enum NiveauVerification {
  /// Aucune pièce déposée.
  DECLARE
  /// Une pièce a été déposée, horodatée et scellée. Constat automatique.
  PIECE_DEPOSEE
  /// La pièce a été examinée à la suite d'une contestation, et retenue.
  PIECE_EXAMINEE
}

/// Statuts déclarés par le consommateur. Recours France ne les vérifie pas
/// auprès du professionnel (hors périmètre MVP).
enum StatutSignalement {
  EN_COURS
  REPONSE_DECLAREE
  SOLUTION_PROPOSEE
  RESOLUTION_PARTIELLE
  RESOLU_CONFIRME
  NON_RESOLU
  ABANDONNE
}

enum EtatModeration {
  EN_ATTENTE
  PUBLIE
  REJETE
  RETIRE
}

enum EtatJustificatif {
  EN_ATTENTE
  CONTROLE
  REFUSE
}

enum EtatDemande {
  EN_ATTENTE
  EN_COURS
  ACCEPTEE
  REFUSEE
}

enum TypeJetonAcces {
  SUIVI_SIGNALEMENT
  RECAPITULATIF_EMAIL
}

// ─────────────────────────────────────────────────────────────────────────────
// Entreprises et données publiques
// ─────────────────────────────────────────────────────────────────────────────

/// Décomptes de l'annuaire, recalculés chaque nuit.
///
/// Compter treize millions de lignes par secteur pour afficher seize nombres
/// coûtait près de deux secondes à chaque régénération de la page d'accueil de
/// l'annuaire. Aucun annuaire de cette taille ne compte en direct.
///
/// La chaîne vide vaut « tous » : elle tient lieu de valeur neutre là où NULL
/// empêcherait la clé primaire de jouer son rôle, deux NULL étant toujours
/// considérés comme distincts.
model CompteurAnnuaire {
  secteur     String
  departement String   @default("")
  nombre      Int
  calculeLe   DateTime @default(now())

  @@id([secteur, departement])
  @@index([secteur])
}

model Entreprise {
  id   String @id @default(cuid())
  slug String @unique

  siren       String  @unique
  siretSiege  String?
  denomination String
  enseigne    String?
  sigle       String?

  formeJuridique     String?
  categorieJuridique String?
  naf                String?
  nafLibelle         String?
  secteur            String?

  dateImmatriculation DateTime?
  dateCessation       DateTime?
  capital             Decimal?  @db.Decimal(16, 2)
  devise              String?   @default("EUR")
  trancheEffectif     String?
  representantLegal   String?
  numeroTva           String?
  greffe              String?

  adresseSiege String?
  codePostal   String?
  commune      String?
  /// Forme normalisée de la commune, servant de segment d'URL aux pages de
  /// regroupement. Stockée plutôt que recalculée : à treize millions de lignes,
  /// retrouver « Fos-sur-Mer » depuis « fos-sur-mer » sans index revient à
  /// balayer la table à chaque visite.
  communeSlug  String?
  departement  String?
  region       String?
  latitude     Float?
  longitude    Float?

  etatAdministratif   EtatAdministratif @default(ACTIVE)
  nombreEtablissements Int              @default(0)
  nombreEtablissementsOuverts Int       @default(0)

  // Coordonnées issues de l'enrichissement du site officiel ou déclarées.
  siteWeb            String?
  /// Comment l'adresse du site a été établie : déclarée par l'entreprise,
  /// indiquée par un consommateur, ou dérivée de la dénomination. Dans les trois
  /// cas elle n'est retenue qu'après avoir trouvé le SIREN sur le site.
  siteWebSource      String?
  /// Page où le SIREN a été retrouvé — la preuve du rattachement.
  siteWebPreuve      String?
  siteWebVerifieLe   DateTime?
  /// Dernière tentative de détection, réussie ou non : évite de re-sonder des
  /// domaines inexistants à chaque synchronisation.
  siteWebTenteLe     DateTime?
  emailReclamation   String?
  telephoneReclamation String?
  urlCgv             String?
  urlContactSav      String?
  urlMentionsLegales String?
  mediationDeclaree  String?

  // Dates de dernière synchronisation, par source.
  syncSirene       DateTime?
  syncRne          DateTime?
  syncBodacc       DateTime?
  syncMediateurs   DateTime?
  syncSiteOfficiel DateTime?

  // Indices publiés (recalculés quotidiennement, historisés dans ScoreSnapshot).
  indiceTransparence Int?
  indiceExperience   Int?
  indicesCalculeLe   DateTime?

  vues      Int      @default(0)
  creeeLe   DateTime @default(now())
  majLe     DateTime @updatedAt

  etablissements Etablissement[]
  evenements     Evenement[]
  signalements   Signalement[]
  boutiques      Boutique[]
  avis           Avis[]
  donnees        DonneeSource[]
  scores         ScoreSnapshot[]
  corrections    Correction[]
  revendications Revendication[]
  comptes        CompteAnnuel[]
  suivis         SuiviEntreprise[]
  mediateur      Mediateur?      @relation(fields: [mediateurId], references: [id])
  mediateurId    String?
  mediateurAdhesionDepuis String?

  @@index([denomination])
  @@index([departement])
  @@index([naf])
  @@index([etatAdministratif])
  // Index de couverture des trois étages de l'annuaire : secteur, puis
  // secteur × département, puis secteur × département × commune.
  @@index([secteur, etatAdministratif])
  @@index([secteur, departement, etatAdministratif])
  @@index([secteur, departement, communeSlug, etatAdministratif])
}

model Etablissement {
  id           String  @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  siret        String  @unique
  estSiege     Boolean @default(false)
  enseigne     String?
  adresse      String?
  codePostal   String?
  commune      String?
  departement  String?
  naf          String?
  actif        Boolean @default(true)
  dateCreation DateTime?
  dateFermeture DateTime?

  source     Source   @default(SIRENE)
  verifieLe  DateTime @default(now())

  @@index([entrepriseId])
}

/// Événement légal enregistré : dépôt de comptes, modification, procédure collective…
model Evenement {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  date      DateTime
  source    Source
  categorie String?
  titre     String
  detail    String?
  reference String?
  urlSource String?
  /// Vrai pour une procédure collective (sauvegarde, redressement, liquidation).
  procedureCollective Boolean @default(false)

  collecteLe DateTime @default(now())

  @@unique([entrepriseId, source, reference])
  @@index([entrepriseId, date])
}

model CompteAnnuel {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  exercice      Int
  dateCloture   DateTime?
  dateDepot     DateTime?
  confidentiel  Boolean  @default(false)
  chiffreAffaires Decimal? @db.Decimal(16, 2)
  resultatNet     Decimal? @db.Decimal(16, 2)

  source    Source   @default(BODACC)
  verifieLe DateTime @default(now())

  @@unique([entrepriseId, exercice])
}

/// Traçabilité fine : pour chaque donnée affichée, sa source et sa date de vérification.
/// Règle métier n° 6 du handoff, opposable car affichée à l'utilisateur.
model DonneeSource {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  /// Nom du champ documenté, ex. « capital », « adresseSiege », « emailReclamation ».
  champ     String
  valeur    String?
  source    Source
  urlSource String?
  collecteLe DateTime @default(now())
  verifieLe  DateTime @default(now())

  @@unique([entrepriseId, champ])
  @@index([entrepriseId])
}

model ScoreSnapshot {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  transparence Int
  experience   Int?
  detail       Json
  calculeLe    DateTime @default(now())

  @@index([entrepriseId, calculeLe])
}

model Mediateur {
  id   String @id @default(cuid())
  slug String @unique

  nom            String
  organisme      String?
  secteurs       String[]
  siteWeb        String?
  email          String?
  adresse        String?
  telephone      String?
  delaiInstruction String? @default("90 jours")
  coutConsommateur String? @default("Gratuit")
  conditionPrealable String? @default("Réclamation écrite restée sans réponse")
  agrementCecmc  Boolean @default(true)

  source    Source   @default(MEDIATEURS)
  verifieLe DateTime @default(now())

  entreprises Entreprise[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Signalements de consommateurs
// ─────────────────────────────────────────────────────────────────────────────

model Signalement {
  id        String @id @default(cuid())
  /// Référence publique, format RF-AAAA-MM-NNNNN.
  reference String @unique

  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  entrepriseId String?
  /// Boutique en ligne concernée, lorsque le litige porte sur un site marchand.
  ///
  /// C'est l'objet que le consommateur connaît : il a acheté sur bergamotte.com,
  /// pas chez VERY BLOOM. Rattacher la déclaration au domaine évite de l'imputer
  /// à une société homonyme, et la personne morale devient un enrichissement
  /// affiché lorsqu'elle est établie.
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)
  boutiqueId String?

  /// Saisie libre lorsque ni l'entreprise ni la boutique n'ont pu être établies.
  entrepriseLibreNom  String?
  entrepriseLibreSite String?
  rapprochementFait   Boolean @default(false)

  categorie   CategorieLitige
  /// Précision choisie par le consommateur sous la situation — « Annoncée
  /// livrée », « Prise en charge refusée ». Dix situations sont proposées pour
  /// six catégories : celui qui cherche ne formule pas son problème avec le
  /// vocabulaire d'une nomenclature.
  sousCategorie String?
  montant     Decimal? @db.Decimal(12, 2)
  /// Le montant est toujours compté dans les statistiques ; c'est son affichage
  /// public que l'auteur accepte ou refuse.
  montantPublic Boolean @default(true)
  dateFaits   DateTime
  contactPrealable ContactPrealable

  /// Expression structurée du litige.
  ///
  /// Ces trois champs remplacent la rédaction libre comme source du résumé
  /// public. Ils sont plus rapides à renseigner qu'une phrase, et surtout
  /// publiables sans modération : ce sont des choix fermés, pas du texte.
  /// Sans eux, deux litiges de même catégorie produisaient exactement la même
  /// phrase publique.
  demande            DemandeConsommateur?
  etatProfessionnel  EtatProfessionnel?
  /// 1, 2, ou 3 pour « trois relances ou plus ».
  relances           Int?

  /// Texte libre du consommateur : JAMAIS publié tel quel (règle métier n° 7).
  /// Facultatif : il ne nourrit que le récapitulatif PDF et le contexte
  /// d'administration. Exiger une rédaction pour un contenu jamais publié
  /// était le principal obstacle du formulaire.
  resume      String?  @db.Text

  /// Identité facultative : le tunnel ne la demande pas.
  ///
  /// Quatre informations sont réclamées avant publication — situation, récit,
  /// montant et date, adresse électronique — et rien d'autre. Exiger un nom
  /// pour un contenu qui paraît sans lui ferait abandonner sans rien apporter.
  prenom String?
  nom    String?
  email  String

  certifie     Boolean @default(false)
  consentement Boolean @default(false)

  niveauVerification NiveauVerification @default(DECLARE)
  verifieLe          DateTime?
  verifiePar         String?

  statut            StatutSignalement @default(EN_COURS)
  /// Le consommateur déclare avoir reçu une réponse du professionnel.
  reponseDeclaree   Boolean   @default(false)
  reponseDeclareeLe DateTime?
  /// Une résolution n'est comptabilisée qu'après confirmation explicite (règle n° 2).
  resolutionConfirmee   Boolean   @default(false)
  resolutionConfirmeeLe DateTime?

  moderation      EtatModeration @default(PUBLIE)
  motifModeration String?

  /// Rappels déjà expédiés au consommateur, pour ne jamais renvoyer deux fois.
  relancesEnvoyees String[]
  /// Le consommateur peut couper les rappels depuis son espace.
  relancesActives  Boolean @default(true)

  creeLe   DateTime  @default(now())
  majLe    DateTime  @updatedAt
  closLe   DateTime?

  ipHash     String?
  userAgent  String?

  justificatifs Justificatif[]
  contestations Contestation[]
  evenements    EvenementSignalement[]
  avis          Avis[]
  jetons        JetonAcces[]

  @@index([entrepriseId, creeLe])
  @@index([boutiqueId, creeLe])
  @@index([email])
  @@index([niveauVerification])
  @@index([statut])
}

/// Pièce déposée par le consommateur. Stockée hors du dossier public, jamais publiée.
model Justificatif {
  id            String @id @default(cuid())
  signalement   Signalement @relation(fields: [signalementId], references: [id], onDelete: Cascade)
  signalementId String

  nomOrigine  String
  typeMime    String
  taille      Int
  /// Chemin relatif dans storage/justificatifs — jamais servi publiquement.
  cheminStockage String
  sommeControle  String?

  etat       EtatJustificatif @default(EN_ATTENTE)
  /// Signaux techniques du contrôle automatique (étage 1).
  anomalies  String[]
  /// Constats de l'analyse de cohérence (étage 2) : nom de l'entreprise, date,
  /// montant, nature du document. Jamais publiés, jamais bloquants.
  observations String[]
  /// Message affiché au déposant lorsqu'un doute mérite d'être signalé.
  conseil      String?
  controleLe DateTime?
  controlePar String?
  motifRefus String?

  deposeLe DateTime @default(now())

  @@index([signalementId])
  @@index([etat])
}

/// Journal horodaté du signalement, alimenté par le consommateur et par l'administration.
model EvenementSignalement {
  id            String @id @default(cuid())
  signalement   Signalement @relation(fields: [signalementId], references: [id], onDelete: Cascade)
  signalementId String

  date    DateTime @default(now())
  titre   String
  detail  String?
  /// « CONSOMMATEUR » ou « RECOURS_FRANCE » : jamais le professionnel (hors périmètre MVP).
  auteur  Source   @default(CONSOMMATEUR)
  etiquette String?

  @@index([signalementId, date])
}

model Avis {
  id String @id @default(cuid())

  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  /// Un avis rattaché à un signalement vérifié entre dans la moyenne publiée.
  signalement   Signalement? @relation(fields: [signalementId], references: [id], onDelete: SetNull)
  signalementId String?

  note   Int
  texte  String @db.Text
  auteur String
  ville  String?
  email  String

  verifie    Boolean @default(false)
  moderation EtatModeration @default(EN_ATTENTE)
  motifModeration String?

  creeLe   DateTime  @default(now())
  publieLe DateTime?

  @@index([entrepriseId, moderation])
}

// ─────────────────────────────────────────────────────────────────────────────
// Demandes utilisateurs
// ─────────────────────────────────────────────────────────────────────────────

model Correction {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  champ       String
  valeurActuelle String?
  valeurProposee String?
  explication String  @db.Text
  email       String
  qualite     String?

  etat      EtatDemande @default(EN_ATTENTE)
  reponse   String?
  traiteLe  DateTime?
  traitePar String?

  creeLe DateTime @default(now())

  @@index([entrepriseId, etat])
}

model Revendication {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  nomContact  String
  fonction    String
  emailPro    String
  telephone   String?
  siretJustifie String?
  message     String? @db.Text

  etat      EtatDemande @default(EN_ATTENTE)
  reponse   String?
  traiteLe  DateTime?
  traitePar String?

  creeLe DateTime @default(now())

  @@index([entrepriseId, etat])
}

model SuiviEntreprise {
  id           String @id @default(cuid())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String

  email    String
  confirme Boolean  @default(false)
  creeLe   DateTime @default(now())

  @@unique([entrepriseId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Accès
// ─────────────────────────────────────────────────────────────────────────────

/// Lien signé envoyé par email : le consommateur retrouve et met à jour son
/// signalement sans créer de compte.
model JetonAcces {
  id       String @id @default(cuid())
  jeton    String @unique
  type     TypeJetonAcces @default(SUIVI_SIGNALEMENT)

  signalement   Signalement? @relation(fields: [signalementId], references: [id], onDelete: Cascade)
  signalementId String?
  email         String

  expireLe   DateTime
  utiliseLe  DateTime?
  creeLe     DateTime @default(now())

  @@index([email])
}

model AdminUser {
  id    String @id @default(cuid())
  email String @unique
  nom   String
  motDePasseHash String
  role  String @default("moderateur")
  actif Boolean @default(true)

  dernierAccesLe DateTime?
  creeLe DateTime @default(now())

  sessions AdminSession[]
  actions  JournalAction[]
}

model AdminSession {
  id      String @id @default(cuid())
  jeton   String @unique
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId String

  expireLe DateTime
  creeLe   DateTime @default(now())
}

/// Journal d'audit : toute action de modération est traçable.
model JournalAction {
  id      String @id @default(cuid())
  admin   AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId String?

  action    String
  cible     String
  cibleId   String?
  detail    String?
  creeLe    DateTime @default(now())

  @@index([creeLe])
}

/// Trace d'exécution des tâches planifiées.
///
/// Sans elle, un ordonnanceur mort passe inaperçu : la plateforme continue
/// d'afficher des dates de dernière vérification qui ne bougent plus, et la
/// promesse « source + date » devient fausse en silence.
model ExecutionTache {
  id      String   @id @default(cuid())
  nom     String
  debutLe DateTime @default(now())
  finLe   DateTime?
  statut  StatutTache @default(EN_COURS)
  traites Int      @default(0)
  echecs  Int      @default(0)
  detail  String?

  @@index([nom, debutLe])
}

enum StatutTache {
  EN_COURS
  SUCCES
  ECHEC
}

/// Contestation d'un signalement par l'entreprise concernée.
///
/// Exigée par l'article L111-7-2 du code de la consommation : une fonctionnalité
/// gratuite doit permettre au professionnel de signaler un doute motivé sur
/// l'authenticité d'un contenu.
///
/// Le dispositif inverse la charge de la preuve : le consommateur est sollicité,
/// et son SILENCE tranche à sa place. Sans réponse dans le délai, le signalement
/// est retiré automatiquement — sans appréciation humaine, sans arbitrage au cas
/// par cas. C'est ce qui rend la publication tenable sans équipe de modération.
model Contestation {
  id            String      @id @default(cuid())
  signalement   Signalement @relation(fields: [signalementId], references: [id], onDelete: Cascade)
  signalementId String

  /// Qui conteste, au nom de l'entreprise.
  email   String
  nom     String
  qualite String
  /// Motivation obligatoire : un signalement non motivé n'ouvre aucune procédure.
  motif   String @db.Text

  etat EtatContestation @default(OUVERTE)

  /// Sollicitation du consommateur et délai qui court.
  pieceDemandeeLe DateTime?
  echeanceReponse DateTime?
  repondueLe      DateTime?

  /// Examen humain, uniquement lorsque le consommateur a répondu.
  trancheeLe  DateTime?
  trancheePar String?
  decision    String?

  creeLe DateTime @default(now())

  @@index([etat, echeanceReponse])
  @@index([signalementId])
}

enum EtatContestation {
  /// Reçue, le consommateur n'a pas encore été sollicité.
  OUVERTE
  /// Le consommateur a été sollicité, le délai court.
  PIECE_DEMANDEE
  /// Silence du consommateur : signalement retiré automatiquement.
  RETIREE_SANS_REPONSE
  /// Le consommateur a répondu : la pièce attend un examen.
  PIECE_FOURNIE
  /// Après examen : la pièce étaye, le signalement est maintenu.
  REJETEE
  /// Après examen : la pièce n'étaye pas, le signalement est retiré.
  ACCEPTEE
}

/// Ce que le consommateur demande au professionnel.
enum DemandeConsommateur {
  REMBOURSEMENT_INTEGRAL
  REMBOURSEMENT_PARTIEL
  LIVRAISON
  REPARATION
  REMPLACEMENT
  RESILIATION
  AUTRE
}

/// Où en est le professionnel, tel que le consommateur le déclare.
enum EtatProfessionnel {
  AUCUNE_REPONSE
  REPONSE_SANS_SOLUTION
  PROMESSE_NON_TENUE
  REFUS_MOTIVE
  SOLUTION_PARTIELLE
}

/// Table SIREN → site officiel importée de Wikidata.
///
/// Stockée localement pour que la synchronisation d'une fiche ne déclenche
/// aucune requête réseau : la recherche se fait hors ligne, sans mur
/// anti-robot ni robots.txt à respecter. Wikidata étant modifiable par tous,
/// la provenance reste enregistrée pour rendre la donnée auditable.
model SiteConnu {
  siren     String   @id
  site      String
  libelle   String?
  /// « wikidata » ou « osm » : les deux sources couvrent des segments
  /// différents — Wikidata les marques notables, OpenStreetMap les commerces
  /// de proximité. La provenance reste enregistrée, aucune n'est autoritaire.
  origine   String   @default("wikidata")
  importeLe DateTime @default(now())

  @@index([site])
}

/// Boutique en ligne, identifiée par son domaine.
///
/// Sujet de fiche à part entière, indépendant de toute personne morale : un
/// consommateur se plaint d'un site marchand, pas d'un numéro SIREN. Ce
/// découplage supprime le risque d'attribuer un litige à une société homonyme —
/// une recherche « Bergamotte » renvoie une entreprise de Montélimar créée en
/// 1978, sans rapport avec bergamotte.com, exploité par VERY BLOOM.
///
/// L'entreprise, quand elle est établie, est rattachée et affichée comme un
/// enrichissement sourcé. Elle n'est jamais une condition d'existence.
model Boutique {
  id      String @id @default(cuid())
  /// Domaine normalisé, sans protocole ni « www » : bergamotte.com.
  domaine String @unique
  /// Nom d'affichage, dérivé du domaine ou fourni par une source.
  nom     String
  slug    String @unique

  /// Personne morale exploitante, lorsqu'elle a été établie.
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  entrepriseId String?
  /// Comment le rattachement a été obtenu : « wikidata », « osm », « facture »,
  /// « mentions-legales », « manuel ». Jamais présenté comme une vérification
  /// quand il provient d'une base contributive.
  rattachementSource String?
  rattachementLe     DateTime?

  vues   Int      @default(0)
  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  signalements Signalement[]

  @@index([entrepriseId])
}
