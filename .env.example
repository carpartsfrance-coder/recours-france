# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/recours_france?schema=public"

# ─── Application ──────────────────────────────────────────────────────────────
# Base publique utilisée dans les emails (liens de suivi de signalement).
APP_URL="http://localhost:3200"
# Secret de signature des sessions admin et des liens de suivi consommateur.
# Générer avec : openssl rand -hex 32
APP_SECRET="changez-moi-en-production"
# Affiche le bandeau « Démonstration — données fictives ». À passer à "false" en production.
DEMO_BANNER="true"

# ─── Envoi d'emails ───────────────────────────────────────────────────────────
# MAIL_ENABLED=false : aucun envoi réel, les messages sont écrits dans .mail-outbox/.
# Ne jamais passer à true en développement avec des adresses réelles.
MAIL_ENABLED="false"
MAIL_FROM="Recours France <ne-pas-repondre@recours-france.fr>"
MAIL_REPLY_TO="justificatifs@recours-france.fr"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── Sources publiques ────────────────────────────────────────────────────────
# API Recherche d'entreprises (Insee/DINUM) — ouverte, sans clé.
RECHERCHE_ENTREPRISES_URL="https://recherche-entreprises.api.gouv.fr"

# API Sirene 3.11 (Insee) — clé facultative, enrichit l'identité et les établissements.
# https://portail-api.insee.fr/
SIRENE_API_URL="https://api.insee.fr/api-sirene/3.11"
SIRENE_API_KEY=""

# API RNE (INPI) — identifiants facultatifs, apportent actes, dirigeants et comptes.
# https://www.inpi.fr/acces-api-entreprises
INPI_API_URL="https://registre-national-entreprises.inpi.fr/api"
INPI_USERNAME=""
INPI_PASSWORD=""

# BODACC (données ouvertes DILA) — ouvert, sans clé.
BODACC_API_URL="https://bodacc-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/annonces-commerciales"

# Liste publique des médiateurs de la consommation (CECMC), rafraîchie chaque mois.
MEDIATEURS_DATASET_URL=""

# Enrichissement du site officiel de l'entreprise (URL, téléphone, email, CGV, SAV, médiation).
ENRICHISSEMENT_SITE_ACTIF="true"

# Destinataire des alertes d exploitation (tâches planifiées arrêtées).
ALERTE_EMAIL=""

# Volume de dossiers en dessous duquel aucune donnée de litige n'est publiée
# sur une fiche. 0 ouvre la publication entièrement.
SEUIL_PUBLICATION_LITIGES="5"

# Publication des avis de consommateurs. Fermée au MVP : voir src/lib/config.ts.
AVIS_ACTIFS="false"
